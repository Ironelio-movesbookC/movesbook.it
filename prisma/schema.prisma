generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                @id @default(cuid())
  email                    String                @unique
  username                 String                @unique
  password                 String
  name                     String
  userType                 UserType
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  birthdate                DateTime?
  country                  String?
  firstName                String?
  gender                   String?
  surname                  String?
  securityQuestion         String?
  securityAnswer           String?
  clubMemberships          ClubMember[]
  ownedClubs               Club[]                @relation("ClubOwner")
  coaches                  CoachAthlete[]        @relation("AthleteCoaches")
  athletes                 CoachAthlete[]        @relation("CoachAthletes")
  coachingGroupMemberships CoachingGroupMember[]
  ownedCoachingGroups      CoachingGroup[]       @relation("CoachingGroupOwner")
  favoriteWorkouts         FavoriteWorkout[]
  favoriteWeeklyPlans      FavoriteWeeklyPlan[]
  favoriteSports           FavoriteSport[]
  freeMoveExercises        FreeMoveExercise[]
  groupMemberships         GroupMember[]
  ownedGroups              Group[]               @relation("GroupOwner")
  periods                  Period[]
  teamMemberships          TeamMember[]
  ownedTeams               Team[]                @relation("TeamOwner")
  mainSports               UserMainSport[]
  settings                 UserSettings?
  workoutDays              WorkoutDay[]
  workoutPlans             WorkoutPlan[]
  sections                 WorkoutSection[]
  executionTechniques      ExecutionTechnique[]
  workoutTemplates         WorkoutTemplate[]
  telegramAccount          String?
  telegramChatId           String?   // Telegram chat id for sending/receiving via bot
  lastSeenAt               DateTime? // For chat online/offline status
  image                    String?   // Profile/avatar image URL or path (users_new table)
  profileBanner            String?   // Cover/banner image path (legacy single-user banner background)
  profileBannerAlignment   String?   // "center" | "default" — object-position for cover (legacy)
  profileBannerSequence    String?   @db.Text // JSON string[] of public image paths for rotating banner
  profileBannerVideo       String?   // Uploaded cover video path (public URL under /uploads/...)
  /// Personal YouTube URL (channel, @handle, or video) for "My channel on YouTube" on My Page.
  youtubeChannelUrl        String?   @db.Text
  superAdminId             String?   @unique // When set, this User mirrors a super_admin for news/OGP attribution
  conversationsStarted    ChatConversation[] @relation("ConversationStarter")
  conversationsReceived   ChatConversation[] @relation("ConversationReceiver")
  chatMessagesSent         ChatMessage[]     @relation("MessageSender")
  newsTopics               UserNewsTopic[]
  ogpArticles              OgpArticle[]
  ogpArticlesDeleted       OgpArticle[]       @relation("OgpDeletedBy")
  ogpArticleLikes          OgpArticleLike[]
  newsTypedArticles       NewsTypedArticle[]
  plannedActionTemplates  PlannedActionTemplate[]
  workoutDayPlannedActions WorkoutDayPlannedAction[]
  sportMachines           SportMachine[]
  loginLogs               UserLoginLog[]
  nutritionDays           NutritionDay[]
  nutritionPlans          NutritionPlan[]
  nutritionSections       NutritionSection[]
  favoriteNutritionMeals  FavoriteNutritionMeal[]
  favoriteNutritionWeeklyPlans FavoriteNutritionWeeklyPlan[]
  nutritionTemplates           NutritionTemplate[]
  nutritionDayPlannedActions   NutritionDayPlannedAction[]

  @@map("users_new")
}

/// Login / logout audit rows for Movesbook users (admin "Logins about users").
model UserLoginLog {
  id        String    @id @default(cuid())
  userId    String
  loginAt   DateTime
  logoutAt  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([userId, logoutAt])
  @@map("user_login_logs")
}

model MyDeskItem {
  id          String      @id @default(cuid())
  userId      String
  parentId    String?
  title       String
  path        String?
  faIconClass String?
  bgColor     String?
  titleColor  String?
  displayMode String? // "new_label" | "central_page"
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   MyDeskItem? @relation("MyDeskParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children MyDeskItem[] @relation("MyDeskParentChild")

  @@index([userId, parentId, sortOrder])
  @@index([parentId])
  @@map("my_desk_items")
}

model UserNewsTopic {
  id          String   @id @default(cuid())
  userId      String
  name        String
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_news_topics")
}

model OgpArticle {
  id                    String    @id @default(cuid())
  userId                String
  title                 String?   @db.Text
  image                 String?   @db.Text
  description           String?   @db.Text
  url                   String    @db.Text
  siteName              String?
  type                  String?
  customDescription     String?   @db.Text
  topic                 String    // Topic name (e.g. "News", "Sport")
  languageCode          String?   // Language of the article e.g. "en", "it" for search/filter
  savedAt               DateTime  @default(now())
  expiresAt             DateTime? // After this date hidden from normal users; admin/super_admin still see
  deletedAt             DateTime? // Set when deleted by creator (soft delete); admin/super_admin delete permanently
  deletedByUserId       String?   // Who performed soft delete (creator's user id); for display "deleted by"
  visibilityUserTypes   String?   @db.Text // JSON array of UserType e.g. ["ATHLETE","COACH"]
  visibilityCountries   String?   @db.Text // JSON array of country names
  visibilityLanguages   String?   @db.Text // JSON array of language codes e.g. ["en","de"]
  visibilitySports      String?   @db.Text // JSON array of SportType e.g. ["RUN","SWIM"]
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy             User?     @relation("OgpDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  likes                 OgpArticleLike[]

  @@index([userId])
  @@index([userId, topic])
  @@index([deletedAt])
  @@map("ogp_articles")
}

model OgpArticleLike {
  id            String      @id @default(cuid())
  ogpArticleId  String
  userId        String
  createdAt     DateTime    @default(now())
  ogpArticle    OgpArticle   @relation(fields: [ogpArticleId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ogpArticleId, userId])
  @@index([ogpArticleId])
  @@index([userId])
  @@map("ogp_article_likes")
}

model NewsTypedArticle {
  id          String   @id @default(cuid())
  userId      String
  description String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("news_typed_articles")
}

model ChatConversation {
  id               String        @id @default(cuid())
  user1Id          String
  user2Id          String
  user1LastReadAt  DateTime?     // Last time user1 read this conversation
  user2LastReadAt  DateTime?     // Last time user2 read this conversation
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user1            User          @relation("ConversationStarter", fields: [user1Id], references: [id], onDelete: Cascade)
  user2            User          @relation("ConversationReceiver", fields: [user2Id], references: [id], onDelete: Cascade)
  messages         ChatMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("chat_conversations")
}

model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  senderId        String
  content         String           @db.Text
  telegramMessageId String?        // id from Telegram when sent/received via bot
  createdAt       DateTime        @default(now())
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("chat_messages")
}

model Language {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news                                    News[]                 @relation("NewsOriginalLanguage")
  newsLanguageTitles                      NewsLanguageTitle[]
  newsSettingLanguages                   NewsSettingLanguage[]

  @@map("languages_new")
}

model Translation {
  id        String   @id @default(cuid())
  key       String
  language  String   
  value     String   @db.Text
  category  String   @default("general") 
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([key, language])
  @@map("translations")
}

model CoachAthlete {
  id        String   @id @default(cuid())
  coachId   String
  athleteId String
  notes     String?
  createdAt DateTime @default(now())
  athlete   User     @relation("AthleteCoaches", fields: [athleteId], references: [id], onDelete: Cascade)
  coach     User     @relation("CoachAthletes", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId], map: "coach_athletes_athleteId_fkey")
  @@map("coach_athletes")
}

model WorkoutPlan {
  id          String          @id @default(cuid())
  userId      String
  name        String
  type        WorkoutPlanType
  storageZone String? // A, B, C to differentiate independent weekly plans
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks       WorkoutWeek[]

  @@index([userId], map: "workout_plans_userId_fkey")
  @@map("workout_plans")
}

model WorkoutWeek {
  id            String       @id @default(cuid())
  workoutPlanId String
  weekNumber    Int
  createdAt     DateTime     @default(now())
  periodId      String?
  notes         String?      
  days          WorkoutDay[]
  period        Period?      @relation("WeekPeriod", fields: [periodId], references: [id])
  workoutPlan   WorkoutPlan  @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  @@index([periodId], map: "workout_weeks_periodId_fkey")
  @@index([workoutPlanId], map: "workout_weeks_workoutPlanId_fkey")
  @@map("workout_weeks")
}

model WorkoutDay {
  id                 String           @id @default(cuid())
  workoutWeekId      String
  date               DateTime
  weekNumber         Int
  dayOfWeek          Int
  periodId           String
  weather            String?
  feelingStatus      String?
  notes              String?          
  createdAt          DateTime         @default(now())
  userId             String
  assignedToUserId   String?
  creatorRole        UserType?
  isFromSharedSource Boolean          @default(false)
  originalSenderId   String?
  storageZone        StorageZone      @default(B)
  period             Period           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutWeek        WorkoutWeek      @relation(fields: [workoutWeekId], references: [id], onDelete: Cascade)
  workouts           WorkoutSession[]
  plannedActions     WorkoutDayPlannedAction[]

  @@unique([userId, date, storageZone])
  @@index([userId, date])
  @@index([userId, storageZone, date])
  @@index([periodId], map: "workout_days_periodId_fkey")
  @@index([workoutWeekId], map: "workout_days_workoutWeekId_fkey")
  @@map("workout_days")
}

/// User-defined action types for Action settings (color, icon, per-language descriptions).
model PlannedActionTemplate {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  nameByLanguage        String?  @db.Text
  descriptionByLanguage String?  @db.Text
  color                 String   @default("#6366f1")
  icon                  String   @default("📌")
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances             WorkoutDayPlannedAction[]
  nutritionInstances    NutritionDayPlannedAction[]

  @@index([userId])
  @@map("planned_action_templates")
}

/// A planned action on a calendar day (Yearly Plan / Done), not a moveframe.
model WorkoutDayPlannedAction {
  id              String   @id @default(cuid())
  workoutDayId    String
  userId          String
  templateId      String?
  nameSnapshot    String
  iconSnapshot    String?
  colorSnapshot   String   @default("#6366f1")
  description     String?  @db.Text
  textColor       String?
  backgroundColor String?
  url             String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workoutDay WorkoutDay             @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  template   PlannedActionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workoutDayId])
  @@index([userId])
  @@index([templateId])
  @@map("workout_day_planned_actions")
}

model Period {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String
  /// JSON map of language code → description (e.g. {"en":"...","it":"..."}). English mirrors `description`.
  descriptionTranslations String? @db.Text
  /// JSON map of language code → period name/title (e.g. {"en":"Base","it":"Base"}). English mirrors `name`.
  nameTranslations String? @db.Text
  color       String
  displayOrder Int          @default(0) // Order for display in lists
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            WorkoutDay[]
  weeks           WorkoutWeek[] @relation("WeekPeriod")
  nutritionDays   NutritionDay[] @relation("NutritionDayPeriod")
  nutritionWeeks  NutritionWeek[] @relation("NutritionWeekPeriod")

  @@index([userId], map: "periods_userId_fkey")
  @@map("periods")
}

model WorkoutSession {
  id                String                @id @default(cuid())
  workoutDayId      String
  sessionNumber     Int
  name              String
  code              String
  time              String
  weather           String?
  location          String?
  surface           String?
  heartRateMax      Int?
  heartRateAvg      Int?
  calories          Int?
  feelingStatus     String?
  notes             String?
  status            WorkoutStatus
  createdAt         DateTime              @default(now())
  includeStretching Boolean               @default(true)
  mainSport         SportType?
  mainGoal          String?
  intensity         String?               @default("Medium")
  tags              String?
  moveframes        Moveframe[]
  sports            WorkoutSessionSport[]
  workoutDay        WorkoutDay            @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@index([workoutDayId], map: "workout_sessions_workoutDayId_fkey")
  @@map("workout_sessions")
}

model WorkoutSessionSport {
  id               String         @id @default(cuid())
  workoutSessionId String
  sport            SportType
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([workoutSessionId], map: "workout_session_sports_workoutSessionId_fkey")
  @@map("workout_session_sports")
}

model Moveframe {
  id                  String         @id @default(cuid())
  workoutSessionId    String
  letter              String
  sport               SportType
  sectionId           String
  type                MoveframeType
  description         String         @db.Text
  createdAt           DateTime       @default(now())
  notes               String?        @db.Text        
  macroFinal          String?
  alarm               Int?
  annotationBgColor   String?
  annotationText      String?
  annotationTextColor String?
  annotationBold      Boolean?       @default(false)
  workType            WorkType?      @default(NONE)
  manualMode          Boolean?       @default(false)
  manualPriority      Boolean?       @default(false) // Priority flag for manual mode display
  favourite           Boolean?       @default(false)
  repetitions         Int?           // Number of series/repetitions for manual mode
  distance            Int?           // Distance value for manual mode (meters) or time value storage
  manualInputType     String?        @default("meters") // For aerobic sports: "meters" or "time" (123456 format)
  appliedTechnique    String?        // Body Building technique applied (for BODY_BUILDING sport only)
  aerobicSeries       Int?           @default(1) // Series/Batteries/Groups for aerobic sports (range 1-9, default 1)
  section             WorkoutSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  workoutSession      WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  movelaps            Movelap[]

  @@index([sectionId], map: "moveframes_sectionId_fkey")
  @@index([workoutSessionId], map: "moveframes_workoutSessionId_fkey")
  @@map("moveframes")
}

model WorkoutSection {
  id          String      @id @default(cuid())
  userId      String
  name        String
  code        String? // Short code (max 5 characters) for compact display
  description String
  /// JSON map of language code → description. English mirrors `description`.
  descriptionTranslations String? @db.Text
  /// JSON map of language code → section name/title. English mirrors `name`.
  nameTranslations String? @db.Text
  color       String
  displayOrder Int        @default(0) // Order for display in lists
  createdAt   DateTime    @default(now())
  moveframes  Moveframe[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "workout_sections_userId_fkey")
  @@map("workout_sections")
}

model ExecutionTechnique {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  /// JSON map of language code → description. English mirrors `description`.
  descriptionTranslations String? @db.Text
  /// JSON map of language code → technique name/title. English mirrors `name`.
  nameTranslations String? @db.Text
  color       String
  sports      String   @default("") // Comma-separated list of sports that can use this technique
  displayOrder Int     @default(0) // Order for display in lists
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "bodybuilding_techniques_userId_fkey")
  @@map("bodybuilding_techniques")
}

model Movelap {
  id               String        @id @default(cuid())
  moveframeId      String
  repetitionNumber Int
  distance         Int?
  speed            String?
  style            String?
  pace             String?
  time             String?
  rowPerMin        Int? // Row/min for ROWING sport (range 10-99)
  reps             Int?
  restType         RestType?
  pause            String?
  alarm            Int?
  sound            String?
  notes            String?        @db.Text
  status           MovelapStatus
  isSkipped        Boolean       @default(false)
  isDisabled       Boolean       @default(false)
  isNewlyAdded     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  macroFinal       String?
  r1               String?
  r2               String?
  exercise         String?
  muscularSector   String?
  weight           String?
  tools            String?
  moveframe        Moveframe     @relation(fields: [moveframeId], references: [id], onDelete: Cascade)

  @@index([moveframeId], map: "movelaps_moveframeId_fkey")
  @@map("movelaps")
}

// ==================== NUTRITION PLANNING (parallel to workouts) ====================

model NutritionPlan {
  id          String            @id @default(cuid())
  userId      String
  name        String
  type        NutritionPlanType
  storageZone String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks       NutritionWeek[]

  @@index([userId], map: "nutrition_plans_userId_fkey")
  @@map("nutrition_plans")
}

model NutritionWeek {
  id              String         @id @default(cuid())
  nutritionPlanId String
  weekNumber      Int
  createdAt       DateTime       @default(now())
  periodId        String?
  notes           String?
  days            NutritionDay[]
  period          Period?        @relation("NutritionWeekPeriod", fields: [periodId], references: [id])
  nutritionPlan   NutritionPlan  @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)

  @@index([periodId], map: "nutrition_weeks_periodId_fkey")
  @@index([nutritionPlanId], map: "nutrition_weeks_nutritionPlanId_fkey")
  @@map("nutrition_weeks")
}

model NutritionDay {
  id                 String                    @id @default(cuid())
  nutritionWeekId    String
  date               DateTime
  weekNumber         Int
  dayOfWeek          Int
  periodId           String
  weather            String?
  feelingStatus      String?
  notes              String?
  createdAt          DateTime                  @default(now())
  userId             String
  assignedToUserId   String?
  creatorRole        UserType?
  isFromSharedSource Boolean                   @default(false)
  originalSenderId   String?
  storageZone        StorageZone               @default(B)
  period             Period                    @relation("NutritionDayPeriod", fields: [periodId], references: [id], onDelete: Cascade)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nutritionWeek      NutritionWeek             @relation(fields: [nutritionWeekId], references: [id], onDelete: Cascade)
  meals              NutritionMeal[]
  plannedActions     NutritionDayPlannedAction[]

  @@unique([userId, date, storageZone])
  @@index([userId, date])
  @@index([userId, storageZone, date])
  @@index([periodId], map: "nutrition_days_periodId_fkey")
  @@index([nutritionWeekId], map: "nutrition_days_nutritionWeekId_fkey")
  @@map("nutrition_days")
}

model NutritionDayPlannedAction {
  id              String   @id @default(cuid())
  nutritionDayId  String
  userId          String
  templateId      String?
  nameSnapshot    String
  iconSnapshot    String?
  colorSnapshot   String   @default("#6366f1")
  description     String?  @db.Text
  textColor       String?
  backgroundColor String?
  url             String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nutritionDay NutritionDay             @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)
  template     PlannedActionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nutritionDayId])
  @@index([userId])
  @@index([templateId])
  @@map("nutrition_day_planned_actions")
}

model NutritionMeal {
  id                String                   @id @default(cuid())
  nutritionDayId    String
  sessionNumber     Int
  name              String
  code              String
  time              String
  weather           String?
  location          String?
  surface           String?
  heartRateMax      Int?
  heartRateAvg      Int?
  calories          Int?
  feelingStatus     String?
  notes             String?
  status            NutritionMealStatus
  createdAt         DateTime                 @default(now())
  includeStretching Boolean                  @default(true)
  mainSport         SportType?
  mainGoal          String?
  intensity         String?                  @default("Medium")
  tags              String?
  nutritionFoods    NutritionFood[]
  sports            NutritionMealSport[]
  nutritionDay      NutritionDay             @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)

  @@index([nutritionDayId], map: "nutrition_meals_nutritionDayId_fkey")
  @@map("nutrition_meals")
}

model NutritionMealSport {
  id              String        @id @default(cuid())
  nutritionMealId String
  sport           SportType
  nutritionMeal   NutritionMeal @relation(fields: [nutritionMealId], references: [id], onDelete: Cascade)

  @@index([nutritionMealId], map: "nutrition_meal_sports_nutritionMealId_fkey")
  @@map("nutrition_meal_sports")
}

model NutritionFood {
  id                  String              @id @default(cuid())
  nutritionMealId     String
  letter              String
  sport               SportType
  sectionId           String
  type                NutritionFoodType
  description         String              @db.Text
  createdAt           DateTime            @default(now())
  notes               String?             @db.Text
  macroFinal          String?
  alarm               Int?
  annotationBgColor   String?
  annotationText      String?
  annotationTextColor String?
  annotationBold      Boolean?            @default(false)
  workType            WorkType?           @default(NONE)
  manualMode          Boolean?            @default(false)
  manualPriority      Boolean?            @default(false)
  favourite           Boolean?            @default(false)
  repetitions         Int?
  distance            Int?
  manualInputType     String?             @default("meters")
  appliedTechnique    String?
  aerobicSeries       Int?                @default(1)
  section             NutritionSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  nutritionMeal       NutritionMeal       @relation(fields: [nutritionMealId], references: [id], onDelete: Cascade)
  nutritionComponents NutritionComponent[]

  @@index([sectionId], map: "nutrition_foods_sectionId_fkey")
  @@index([nutritionMealId], map: "nutrition_foods_nutritionMealId_fkey")
  @@map("nutrition_foods")
