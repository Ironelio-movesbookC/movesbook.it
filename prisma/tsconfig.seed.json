{
    "compilerOptions": {
      "target": "ES2019",
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "noEmit": true,
      "baseUrl": "..",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "include": [
      "seed.ts",
      "../src/lib/news/contentParser.ts",
      "../src/constants/**/*.ts",
      "../src/lib/promocodes/**/*.ts",
      "../src/lib/outcomeSettingsDb.ts",
      "../src/lib/prisma.ts",
      "../src/lib/users/quickRegisterSubscriptionSeed.ts"
    ]
  }