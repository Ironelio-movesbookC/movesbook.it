# Database
DATABASE_URL="mysql://root@127.0.0.1:3306/movesbook_nextjs"                                                                                                                                                                                                                                        <!---->                                                                                                                  

# JWT Secret (fallback if private.pem is not available)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Admin Credentials (Fallback - for emergency access)
# Note: These are only used if no admin exists in database
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@movesbook.com"

# Admin Password Hash (bcrypt)
# Generate using: node hash-admin-password.js
# IMPORTANT: Change this for production!
# Run: node hash-admin-password.js to generate a new hash
ADMIN_PASSWORD_HASH="$2a$12$XabKUB4Yas3AafvzbTWcWO2/oXZfsNb7VJvvi.LxJJxZlXRnkZNGW"

# To generate a new admin password hash:
# 1. Run: node hash-admin-password.js
# 2. Enter your desired password when prompted
# 3. Copy the bcrypt hash
# 4. Replace ADMIN_PASSWORD_HASH value above

# Production Security Notes:
# - Never commit .env file to version control
# - Use strong passwords in production
# - Consider disabling fallback admin after setup
# - Store secrets in secure environment (e.g., AWS Secrets Manager)

# Translation API (Optional)
# For auto-translation feature in Settings -> Languages
# If not set, will use free LibreTranslate API as fallback
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=""

